{
  "name": "shadcv",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source bilingual resume template and portable React document built with Next.js, React 19, Tailwind CSS v4, and shadcn/ui.",
  "author": "Jan Hindemit <janhindemit1@gmail.com> (https://janhindemit.de)",
  "license": "MIT",
  "homepage": "https://demo.shadcv.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hundemit/shadcv.git"
  },
  "bugs": {
    "url": "https://github.com/Hundemit/shadcv/issues"
  },
  "keywords": [
    "resume",
    "cv",
    "template",
    "nextjs",
    "react",
    "tailwindcss",
    "shadcn-ui",
    "typescript",
    "pdf",
    "bilingual",
    "portfolio"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:export && pnpm build",
    "resume:export": "node scripts/export-resume.mjs",
    "test:export": "node --test scripts/export-resume.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.13 <23"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7 <11.0.1": "11.0.1",
      "postcss-selector-parser@<6.1.5": "6.1.5"
    }
  }
}
